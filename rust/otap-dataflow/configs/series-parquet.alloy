// The Grafana Alloy producer of the buffered reference deployment
// (`series-parquet-buffered.yaml`): the engine answers once a request is in
// its WAL, in tens of milliseconds. Run Alloy with
//   alloy run --stability.level=public-preview --storage.path=<persistent dir>
// The storage path keeps the file positions and the sending queue across a
// restart; the flag enables the queue's file storage. The strict variant is
// `series-parquet-strict.alloy`.
loki.source.file "series" {
  targets = [{ __path__ = "/input/events.log", job = "series-e2e" }]
  forward_to = [otelcol.receiver.loki.series.receiver]
  tail_from_end = false
}

otelcol.receiver.loki "series" {
  output {
    logs = [otelcol.processor.transform.series.input]
  }
}

// The lake takes its producer_id column from the resource attribute named by
// `producer_id_attribute` (`host.id`), which the Loki bridge does not supply.
// Each producer needs its own value: SERIES_PRODUCER_ID, else the hostname.
// `service.name` feeds the denormalized service column.
otelcol.processor.transform "series" {
  error_mode = "ignore"
  log_statements {
    context = "resource"
    statements = [
      string.format(`set(attributes["host.id"], %q)`,
        coalesce(sys.env("SERIES_PRODUCER_ID"), constants.hostname)),
      `set(attributes["service.name"], "series-e2e-service")`,
    ]
  }
  output {
    logs = [otelcol.processor.attributes.series.input]
  }
}

otelcol.processor.attributes "series" {
  action {
    key = "e2e.source"
    value = "alloy-file"
    action = "insert"
  }
  output {
    logs = [otelcol.processor.batch.series.input]
  }
}

// The Loki bridge turns every line into its own request; the batch makes one
// export of up to 4000 lines. The Loki bridge adds about 300 bytes per line on
// the wire, so 4000 lines of 100 bytes are 1.6 MB, and lines of up to about
// 3.9 KB stay under the engine receiver's 16MiB max_decoding_message_size (an
// export above it gets OUT_OF_RANGE and is retried without end).
otelcol.processor.batch "series" {
  send_batch_size     = 4000
  send_batch_max_size = 4000
  timeout             = "5s"
  output {
    logs = [otelcol.exporter.otlp.series.input]
  }
}

// Survives an Alloy restart: without it the queued batches, whose lines the
// file positions have already passed, are lost.
otelcol.storage.file "queue" {}

otelcol.exporter.otlp "series" {
  // Twice the slowest WAL acknowledgement measured (p99 4.4s at the WAL
  // device's ceiling; 20-50ms below it). `SERIES_ALLOY_TIMEOUT` lets a test
  // choose another value.
  timeout = coalesce(sys.env("SERIES_ALLOY_TIMEOUT"), "10s")
  client {
    endpoint = sys.env("OTLP_ENDPOINT")
    compression = "none"
    tls {
      insecure = true
    }
  }
  sending_queue {
    enabled = true
    storage = otelcol.storage.file.queue.handler

    // Parallel exports. One export takes 4000 lines per WAL write, so two
    // carry 2 * 4000 / 0.05s = 160k lines/s at a 50ms acknowledgement. The
    // engine refuses an export beyond its receiver's max_concurrent_requests
    // (128 per worker) with RESOURCE_EXHAUSTED, which this exporter drops
    // without retrying, so the num_consumers of every producer that can reach
    // one worker must sum to at most that: 64 producers here.
    num_consumers = 2

    // Measured in records. An export keeps its records in the queue until it
    // completes, so the queue holds the consumers' batches and as many
    // waiting: 2 * 2 * 4000 = 16000.
    sizer = "items"
    queue_size = 16000

    // The source is a file. A full queue parks the tailer and leaves the
    // unread lines on disk; dropping is the default and loses them.
    block_on_overflow = true
  }
  // Never give up: a batch whose retries end is dropped. While the WAL is
  // full the engine answers UNAVAILABLE; the queue fills, the tailer parks,
  // and the lines wait in the file. The 5s cap resumes a producer within 5s
  // of the engine answering again.
  retry_on_failure {
    enabled = true
    initial_interval = "500ms"
    max_interval = "5s"
    max_elapsed_time = "0s"
  }
}
