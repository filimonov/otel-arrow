# Site values: the bucket with its prefix, and its region. These are for AWS
# S3 over HTTPS, the client's default endpoint.
SERIES_S3_BASE_URI=s3://series-test/otel
AWS_REGION=us-east-1
# For a MinIO in the cluster, which serves plain HTTP and path-style
# requests, uncomment these three lines:
# AWS_ENDPOINT_URL=http://minio.minio.svc:9000
# AWS_ALLOW_HTTP=true
# AWS_VIRTUAL_HOSTED_STYLE_REQUEST=false
